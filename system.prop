# nubia Z70S Ultra (NX737J) system props — bootstrap
#
# 每一条都是「少了会开不了机 / 显示奇怪 / 特权权限崩」的兜底，不是随意堆的。
# 屏幕密度/刘海/刷新率不在这，来自 TARGET_SCREEN_DENSITY + stock vendor RRO。

ro.zygote=zygote64

# 设备可见名：设置「关于手机」里的市场名。
# ro.product.model 已经由 lineage_NX737J.mk 的 PRODUCT_MODEL 设成 "nubia Z70S Ultra"，
# 这里再补 marketname，两个都指到同一个名字，App 小尾巴和关于页不会打架。
ro.product.marketname=nubia Z70S Ultra

# VINTF 兼容性检查要读这条，**开不了机级别的重要**
#
# 开机时 system_server 会做一次 VINTF 检查：
#     厂商 manifest 的 target-level  <=  ro.board.api_level
# 不满足就直接判为不兼容，起不来。
#
# ro.board.api_level 没设的时候会退回 ro.vndk.version，再退回 ro.build.version.sdk。
# 而这台机器的 ro.vndk.version 是**空的**（我们实测过，说明它不走 VNDK，
# 靠 LLNDK + vendor snapshot —— 这也正是 A17 system 能配 A15 vendor 的原因）。
# 于是就会退到 sdk=37，去和厂商 manifest 的 202404 比，必然判不兼容。
#
# 原机实测值（MIX 7：system 17/CP2A + odm 15/AQ3A 官方就这么出货）：
#     ro.board.api_level       = 202404
#     ro.board.first_api_level = 202404
#     ro.product.first_api_level = 35   ← 这个由 device.mk 的 PRODUCT_SHIPPING_API_LEVEL 给
#
# 我们只编 system，不编 vendor，所以这里显式写一遍兜底。值与原厂一致，不会改变行为。
ro.board.api_level=202404
ro.board.first_api_level=202404

# 首次 bring-up 保险：priv-app 特权权限校验降级为「只记日志」
#
# 我们保留了原厂 product（里面一堆 MIUI priv-app），它们会请求 AOSP 不认识的
# signature|privileged 权限。user 构建默认 enforce 时，PackageManager 扫描阶段
# 直接抛异常 → 开不了机。userdebug 默认就是 log，这行主要给后面 user 包兜底。
# 确认能开机、权限白名单处理干净之后可以删。
ro.control_privapp_permissions=log

# 5G 默认网络模式：双卡都 NR SA（独立组网）。
# 实测移植包 ro.telephony.default_network = 32,32（双 5G SA），vendor 同一个、
# RIL/modem 支持 SA，所以照抄。不设的话 AOSP 默认回落到 LTE，5G 得手动切。
# 值含义：32 = NETWORK_MODE_NR_SA，双卡所以 32,32。
ro.telephony.default_network=32,32
